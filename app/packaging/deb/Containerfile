# Build environment for the Debian package: Ubuntu 22.04 (glibc 2.35), so the program also
# runs on Ubuntu 22.04 and newer and on Debian 12 and newer.
FROM docker.io/library/ubuntu:22.04
RUN apt-get update -qq \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends gcc libc6-dev curl ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && curl -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain stable
ENV PATH=/root/.cargo/bin:$PATH
