# Build environment for the Windows 64-bit version: Rust, the MinGW-w64 linker and wixl (msitools),
# which makes the MSI installer.
FROM docker.io/library/rust:1-bookworm
RUN apt-get update \
 && apt-get install -y --no-install-recommends gcc-mingw-w64-x86-64 msitools wixl \
 && rustup target add x86_64-pc-windows-gnu
